CLAUDE.md

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Env / secrets
.env
*.pem
.aws/

# Terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/terraform.tfvars
# .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions and should be committed.

# Data (raw pulls can be large / regenerable — keep sample only)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# OS / editor
.DS_Store
.vscode/
*.log

# Claude Code local tooling state (not project content)
.claude/
